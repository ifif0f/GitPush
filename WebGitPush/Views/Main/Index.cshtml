@{
    Layout = "_Layout";
    ViewBag.Title = "Главная";
}

<div class="management-page">
    <h1>Управленческая компания</h1>

    <h2 class="main-title">Выбор экранов</h2>
    <div class="management-buttons">
        <a href="/Window1"><button class="management-btn" type="button">Экран_1</button></a>
    </div>

    <h2 class="main-title">Доступ к видеокамерам</h2>

    @if (!ViewBag.IsRunning)
    {
        <form method="post" action="/Main/StartCamera" class="management-form">
            <label class="management-label">Список камер:</label>
            <select name="deviceName" class="management-select">
                @if (ViewBag.DeviceList != null)
                {
                    @foreach (var item in ViewBag.DeviceList)
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                }
            </select>
            <input type="submit" value="Начать показ" class="management-submit" />
        </form>
    }
    else
    {
        <form method="post" action="/Main/StopCamera" class="management-form">
            <input type="submit" value="Остановить показ" class="management-submit-stop" />
        </form>
        <img src="/Main/Video" class="management-video" />
    }
</div>